# PostgreSQL connection
DATABASE_URL="postgresql://pg:pg@localhost:5432/pgmanager"

# Public base URL, used in payment links sent to tenants (optional on Vercel)
APP_URL="http://localhost:3000"

# Protects /api/cron/reminders (call it daily from Vercel Cron, cron-job.org, etc.)
CRON_SECRET="change-me"

# Automatic reminder delivery: log | whatsapp_cloud | webhook
REMINDER_PROVIDER="log"

# WhatsApp Cloud API (REMINDER_PROVIDER=whatsapp_cloud). The template needs 4 body
# parameters: tenant name, amount, month, payment link.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_NAME="rent_reminder"
WHATSAPP_TEMPLATE_LANG="en"

# Generic webhook (REMINDER_PROVIDER=webhook): receives JSON {phone, message, ...}
REMINDER_WEBHOOK_URL=""
